# Application
# Local: http://localhost:3000
# Production: https://your-project.vercel.app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
NEXT_PUBLIC_ENABLE_DEMO_REMOTE=false

# Supabase public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server only
# Use an sb_secret_ key (or legacy service_role). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Invitation security
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INVITATION_TOKEN_PEPPER=

# Cleanup / cron
# Generate a different value from INVITATION_TOKEN_PEPPER.
CLEANUP_CRON_SECRET=
